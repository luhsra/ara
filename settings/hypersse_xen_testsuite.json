{
	"steps": [
		"HyperSSE"
	],

	"BBSplit": {
		"dump": true
	},
	"SystemRelevantFunctions" : {
		"xen_syscall": true
	},
	"SysFuncts" : {
		"xen_syscall": true
	},
	"LLVMMap" : {
		"log_level": "error",
		"dump": false
	},
	"SVFAnalyses": {
		"log_level": "warning",
		"hide_svf_output": true
	},
	"Printer": {
		"log_level": "warning",
		"label": false,
		"only_min_attrs": false
	},
	"SysCall": {
		"log_level": "debug"
	},
	"OS_BASE": {
		"log_level": "debug"
	},
	"DumpCFG": {
		"add_legend": false
	},
	"DumpInstances": {
		"add_legend": false
	},

	"SIA": {
		"dump": false
	},
	"SSE": {
		"dump": true
	},
	
	"logger": {
		"AUTOSAR": "warning",
		"Zephyr": "debug",
		"XEN": "info"
	},
	"MultiSSE": {
		"with_times": true,
		"dump": true,
		"log_level": "warning",
		"per_round_dump": false,
		"reduced_dump": false,
		"anonymous": false
	},

	"HyperSSE": {
		"do_stats": "@do_stats@",
		"testname": "@name@",
		"do_timings": "@do_timings@",
		"guests": "@guests@"
	}

}
