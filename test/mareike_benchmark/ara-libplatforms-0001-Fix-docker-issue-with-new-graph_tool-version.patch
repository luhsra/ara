From: Mareike Burg <mareike.burg@web.de>
Date: Mon, 3 Mar 2025 13:14:56 +0100
Subject: [PATCH 1/2] Fix docker issue with new graph_tool version

---
 Docker/Dockerfile | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Docker/Dockerfile b/Docker/Dockerfile
index 183cadd..de679c4 100644
--- a/Docker/Dockerfile
+++ b/Docker/Dockerfile
@@ -8,7 +8,7 @@ ENV DEBIAN_FRONTEND=noninteractive
 ENV TZ=Europe/Berlin
 
 # graph tool is not installed to /usr/include
-ENV CPATH=/usr/lib/python3/dist-packages/graph_tool/include
+ENV CPATH=/usr/local/lib/python3.11/dist-packages/graph_tool/include
 
 # go packages go here
 ENV GOBIN=/usr/local/bin/
