digraph G {
label=MSTG;
1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD PORT="c0">CPU 0</TD><TD PORT="c1">CPU 1</TD></TR></TABLE>>, shape=plaintext, tooltip=1];
subgraph cluster_5 {
label="M5 (CPU 0)";
2 [color=green, fontsize=14, label=<State 12<br/><font point-size='12'><i>irq_on</i>: True<br/><i>instance</i>: A<br/><i>call_path</i>: CallPath()<br/><i>type</i>: computation<br/><i>abb</i>: ABB0 <br/><i>kernel</i>: None<br/><i>bcet/wcet</i>: 0/0</font>>, tooltip=2];
