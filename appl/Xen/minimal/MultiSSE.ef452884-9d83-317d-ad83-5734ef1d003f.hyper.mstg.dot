4 [color=green, fontsize=14, label=<State 15<br/><font point-size='12'><i>irq_on</i>: True<br/><i>instance</i>: Idle<br/><i>call_path</i>: CallPath()<br/><i>type</i>: idle<br/><i>abb</i>: None<br/><i>kernel</i>: None</font>>, tooltip=4];
}

